# ─────────────────────────────────────────────────────────────────────────────
# SOURA configuration. Copy to .env and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# "development" | "test" | "staging" | "production". Production/staging enable
# strict checks (SESSION_SECRET required) and forbid demo seeding.
APP_ENV=development
# Public origin of the site (used for links in emails, canonical URLs, CSRF).
# Use https:// in production: it enables Secure/__Host- cookies and HSTS.
APP_URL=http://localhost:3000

# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=

# ── Database (SQLite via libSQL) ────────────────────────────────────────────
# Local file (default) or a Turso/libSQL URL (libsql://…) with an auth token.
DATABASE_URL=file:.data/soura.db
DATABASE_AUTH_TOKEN=

# ── File storage ────────────────────────────────────────────────────────────
# "local" stores files under STORAGE_LOCAL_DIR (dev, single server with a volume).
# "s3" uses any S3-compatible bucket — recommended: a PRIVATE Cloudflare R2 bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# "console" writes emails to .data/mail (development). "resend" sends for real.
EMAIL_PROVIDER=console
EMAIL_FROM="SOURA <no-reply@example.org>"
RESEND_API_KEY=
# Optional: address alerted immediately when an urgent report is received.
MODERATION_ALERT_EMAIL=

# ── AI safety pre-check (advisory only; never approves anything) ────────────
# "none" (photos stay pending, marked "AI check unavailable"), "mock" (tests),
# or "openai" (omni-moderation, free endpoint; needs an API key).
MODERATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=20000

# ── Upload limits ───────────────────────────────────────────────────────────
# 30 MB
UPLOAD_MAX_BYTES=31457280
# px
UPLOAD_MIN_LONG_EDGE=2000
# px
UPLOAD_MIN_SHORT_EDGE=1000
# decompression-bomb guard
UPLOAD_MAX_PIXELS=120000000
UPLOADS_PER_HOUR=10
UPLOADS_PER_DAY=30
MAX_PENDING_PER_USER=40
# watermarked public preview
PREVIEW_LONG_EDGE=1600

# ── Moderation ──────────────────────────────────────────────────────────────
# distinct reporters before auto-hide
REPORT_AUTOHIDE_THRESHOLD=3
# rejected files are deleted after this
REJECTED_RETENTION_DAYS=7

# ── Network / jobs ──────────────────────────────────────────────────────────
# How to read the visitor IP for rate limiting: none | cloudflare | xff
TRUST_PROXY=none
# Bearer token for POST /api/cron/cleanup (call it daily from a scheduler).
CRON_SECRET=

# ── Optional integrations ───────────────────────────────────────────────────
# Cookieless analytics script (e.g. Plausible/Umami). Leave empty to disable.
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=
# Purge Cloudflare cache for media URLs when a photo is hidden or removed.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ── Demo data (never in production) ─────────────────────────────────────────
ALLOW_DEMO_SEED=false
