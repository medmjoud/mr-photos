{
  "name": "soura",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "SOURA \u2014 Mauritania, seen by its own people. Discover photographs and contact the photographers who took them.",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "seed:demo:remove": "tsx --env-file-if-exists=.env scripts/seed-demo.ts --remove",
    "jobs:cleanup": "tsx --env-file-if-exists=.env scripts/cleanup.ts",
    "map:build": "tsx scripts/build-map.ts",
    "predev": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/markazi-text": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@libsql/client": "0.18.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "nitro": "3.0.260610-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "use-intl": "4.14.9",
    "zod": "4.6.7",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/eslint-config": "0.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.20.0",
    "exifr": "7.1.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  }
}
